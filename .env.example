# ==============================================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).
# ==============================================================================

# ---- Ambiente ----
# dev | staging | prod — controla qual perfil de config/*.yaml e schema Postgres é usado
APP_ENV=dev
LOG_LEVEL=INFO

# ---- Postgres (destino do dlt / fonte do SQLMesh) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mec_inep
POSTGRES_USER=mec_inep_user
POSTGRES_PASSWORD=troque_esta_senha
# Schema onde o dlt grava os dados "raw/staged" antes do SQLMesh transformar
POSTGRES_RAW_SCHEMA=raw

# ---- APIs do MEC / INEP ----
# Preencha caso as APIs exijam chave/token (algumas bases do INEP são públicas e não exigem).
INEP_API_BASE_URL=https://api.inep.gov.br
INEP_API_TOKEN=

MEC_API_BASE_URL=https://api.mec.gov.br
MEC_API_TOKEN=

# ---- dlt ----
# Nome do pipeline dlt (usado para isolar estado/checkpoints de carga incremental)
DLT_PIPELINE_NAME=mec_inep_pipeline
# Diretório local onde o dlt guarda seu estado (pode apontar para volume persistente no Codespace)
DLT_DATA_DIR=.dlt_data

# ---- SQLMesh ----
# Gateway/ambiente padrão definido em sqlmesh/config.yaml
SQLMESH_GATEWAY=postgres
